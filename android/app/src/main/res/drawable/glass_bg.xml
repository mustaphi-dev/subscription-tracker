<?xml version="1.0" encoding="utf-8"?>
<!-- Brand background (kBg) with the purple glow (kGlow) from the top-right, like the iOS widget. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="24dp" />
            <solid android:color="#07080C" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="24dp" />
            <gradient android:type="radial" android:gradientRadius="180dp" android:centerX="1" android:centerY="0"
                android:startColor="#735A3FF0" android:endColor="#005A3FF0" />
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
        </shape>
    </item>
</layer-list>
